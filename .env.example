DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_API_KEY=
OPENAI_MODEL=
OPENAI_API_KEY=
DEEPSEEK_SEARCH_API_KEY=
ANKICONNECT_URL=http://127.0.0.1:8765
ANKICONNECT_API_KEY=
# Optional absolute path for writable user state:
ANKICARD_DATA_DIR=
