{
  "format_version": 1,
  "taxonomy_version": "0.4.0",
  "status": "draft",
  "updated": "2026-10-31",
  "canonical": true,
  "description_zh": "跨语言词汇标签表；英文标签、中文说明。已接入生成与校验，未迁移旧 Anki。",
  "naming": {
    "pattern": "^[a-z][a-z0-9_]*(::[a-z][a-z0-9_]*)*$",
    "separator": "::",
    "case": "lowercase",
    "segment_style": "snake_case",
    "max_segments": 8,
    "max_tag_length": 160,
    "tag_language": "en",
    "alias_rule": "aliases are lookup-only English alternative names; never write aliases as Anki tags"
  },
  "dimensions": [
    {
      "id": "pos",
      "label_zh": "词性",
      "extension_policy": "controlled"
    },
    {
      "id": "origin",
      "label_zh": "语源",
      "extension_policy": "controlled"
    },
    {
      "id": "domain",
      "label_zh": "主题与专业领域",
      "extension_policy": "extensible"
    },
    {
      "id": "context",
      "label_zh": "使用场景",
      "extension_policy": "extensible"
    },
    {
      "id": "register",
      "label_zh": "语体",
      "extension_policy": "extensible"
    },
    {
      "id": "time",
      "label_zh": "时代与时效",
      "extension_policy": "extensible"
    },
    {
      "id": "regional",
      "label_zh": "地域限定用法",
      "extension_policy": "controlled"
    },
    {
      "id": "connotation",
      "label_zh": "评价与感情色彩",
      "extension_policy": "extensible"
    },
    {
      "id": "sensitivity",
      "label_zh": "冒犯与禁忌",
      "extension_policy": "extensible"
    },
    {
      "id": "politeness",
      "label_zh": "礼貌与敬语",
      "extension_policy": "extensible"
    },
    {
      "id": "form",
      "label_zh": "词条形式",
      "extension_policy": "extensible"
    }
  ],
  "rules": {
    "unit": "note",
    "sense_link_required": true,
    "sense_union": true,
    "language_codes": [
      "en",
      "ja",
      "ko"
    ],
    "universal_language_marker": "*",
    "emit_most_specific_only": true,
    "emit_parent_tags": false,
    "parent_search_includes_descendants": true,
    "group_tags_assignable": false,
    "unknown": "Optional dimensions may be omitted if unsupported; missing required POS or ja/ko origin blocks publishing instead of guessing.",
    "origin": {
      "languages": [
        "ja",
        "ko"
      ],
      "allowed": [
        "origin::native",
        "origin::loanword",
        "origin::sino"
      ],
      "max_per_sense": 3,
      "mixed_policy": "Assign every applicable origin tag to a mixed-source word; retain component-specific reasons. Origin is required for every ja/ko sense; forbidden for en.",
      "script_is_not_evidence": true,
      "required_per_sense": true
    },
    "evidence_priority": [
      "dictionary_sense_label",
      "dictionary_definition",
      "reliable_reference",
      "ai_inference"
    ],
    "extension": {
      "controlled": [
        "pos",
        "origin",
        "regional"
      ],
      "extensible": [
        "domain",
        "context",
        "register",
        "time",
        "connotation",
        "sensitivity",
        "politeness",
        "form"
      ],
      "automatic_use_after_validation": false,
      "new_top_level_dimension": "requires_user_confirmation",
      "new_tags_initial_status": "needs_review",
      "validate_before_use": [
        "resolve aliases and existing equivalents",
        "validate English naming and parent",
        "define meaning and non-overlap",
        "record language scope and rationale",
        "check evidence fits the sense",
        "reject group-only parents as assignments"
      ],
      "workflow_statuses": [
        "seed",
        "confirmed",
        "auto_added",
        "needs_review",
        "deprecated"
      ],
      "seed_meaning": "Initial proposal awaiting user review; not all entries are user-confirmed.",
      "review_rule": "All new proposals currently require review and do not modify the global catalog automatically.",
      "merge_rule": "Choose canonical target, preserve alias/redirect and audit trail; update Anki only through a separately implemented migration."
    },
    "assignment": [
      "Use only evidenced senses actually included in the note.",
      "Match dictionary labels before inferring; retain exact source labels in metadata.",
      "Do not derive topics from incidental example sentences.",
      "Use multiple POS tags only when senses justify them.",
      "Do not force optional dimensions; POS and ja/ko origin are required per sense.",
      "Record time-sensitive claims with an as-of date.",
      "Do not infer learner proficiency, frequency, JLPT, TOPIK or CEFR level from AI intuition.",
      "Regional tags describe restricted usage, not standard language or preferred pronunciation.",
      "Domains classify core referents and topics, including everyday landforms and plants; technical register is not required. Do not infer domains from incidental examples.",
      "POS is mandatory per sense; origin is mandatory per ja/ko sense and may be multi-valued for mixed components.",
      "Neutral common vocabulary is not informal merely because it occurs in conversation."
    ],
    "status_storage": "catalog metadata only; not Anki tags",
    "runtime_boundary": "Generation, catalog validation and semantic tag repair implemented; global proposal registration and old Anki migration remain separate.",
    "domain_granularity": {
      "max_segments": 3,
      "policy": "Keep broad subjects only, e.g. computing, electronics, linguistics. Do not auto-create subfields under these or other subject tags. New broad subjects may be added within this depth; finer subdivisions require user confirmation.",
      "existing_anki_tags": "Existing user-defined Anki descendants may be reused below the default proposal depth; the three-segment limit applies only to AI-created proposals."
    },
    "pos_mapping": {
      "allowed": [
        "pos::noun",
        "pos::verb",
        "pos::adjective",
        "pos::adverb",
        "pos::affix",
        "pos::other"
      ],
      "proper_noun": "pos::noun",
      "ja_i_adjective": "pos::adjective",
      "ja_na_adjective": "pos::adjective",
      "ko_descriptive_adjective": "pos::adjective",
      "ja_suru_verb": "pos::verb",
      "remaining_known_categories": "pos::other",
      "unknown": "omit; do not use other to hide uncertainty",
      "source_detail": "Preserve original dictionary POS in metadata, not new tags."
    },
    "regional_policy": {
      "en": [
        "regional::uk",
        "regional::us",
        "regional::other"
      ],
      "ja": [
        "regional::kansai",
        "regional::other"
      ],
      "ko": [
        "regional"
      ],
      "default": "omit for standard or mutually intelligible general usage",
      "evidence": "regional restriction, never accent choice or dictionary publisher location"
    },
    "runtime_tag_source": "Merge seed catalog with a read-only per-batch Anki getTags snapshot; generation, review and validation share the snapshot."
  },
  "sources": [
    {
      "id": "ud",
      "title": "Universal Dependencies: Universal POS tags",
      "url": "https://universaldependencies.org/u/pos/all.html",
      "use_zh": "参考跨语言词性分层思路；本表是面向词汇学习的改编，并非 UD 兼容标注集。"
    },
    {
      "id": "oxford",
      "title": "Oxford Learner's Dictionaries: Labels",
      "url": "https://www.oxfordlearnersdictionaries.com/about/english/labels",
      "use_zh": "参考词典对语体、专业领域、地域和用法限制的区分；未复制其标签表。"
    },
    {
      "id": "cefr",
      "title": "Council of Europe: CEFR",
      "url": "https://www.coe.int/en/web/portfolio/the-common-european-framework-of-reference-for-languages-learning-teaching-assessment-cefr-",
      "use_zh": "参考 personal、public、educational、occupational 四种使用场景，与主题领域分开。"
    },
    {
      "id": "ninjal",
      "title": "NINJAL: UniDic 中古和文标注规范",
      "url": "https://clrd.ninjal.ac.jp/chj/doc/unidic-MLJ_rulebook_v1_1.pdf",
      "use_zh": "说明日本语有混种语边界，不将所有条目强行归入单一三分法。"
    },
    {
      "id": "krdict",
      "title": "National Institute of Korean Language: Korean Basic Dictionary Open API",
      "url": "https://krdict.korean.go.kr/kor/openApi/openApiInfo",
      "use_zh": "参考固有语、汉字语、外来语与混种语的词源分类边界。"
    },
    {
      "id": "anki_search",
      "title": "Anki Manual: Searching",
      "url": "https://docs.ankiweb.net/searching.html",
      "use_zh": "层级标签、组合查询的依据。"
    },
    {
      "id": "anki_filtered",
      "title": "Anki Manual: Filtered Decks",
      "url": "https://docs.ankiweb.net/filtered-decks.html",
      "use_zh": "按标签生成筛选牌组进行复习的依据。"
    }
  ],
